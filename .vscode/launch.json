{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Client",
            "type": "coreclr",
            "request": "launch",
            "program": "${config:renderdoc.path}/renderdoccmd.exe",
            "preLaunchTask": "build-and-tail",
            "postDebugTask": "stop-and-scan-clientlog",
            "env": {
                "VGE_DATA_PATH": "${config:vsmod.debugGame.dataPath}"
            },
            "args": [
                "capture",
                "--wait-for-exit",
                "${env:VINTAGE_STORY}/Vintagestory.exe",
                "--openWorld", "TestWorld",
                "--tracelog",
                "--dataPath",
                "${config:vsmod.debugGame.dataPath}",
                "--addModPath",
                "${config:vsmod.projectFolder}/bin/Debug/Mods",
                "--addOrigin",
                "${config:vsmod.projectFolder}/assets"
            ],
            "cwd": "${env:VINTAGE_STORY}",
            "console": "internalConsole",
            "internalConsoleOptions": "neverOpen",
            "stopAtEntry": false
        },
        {
            "name": "Launch Client (Nsight Graphics)",
            "type": "coreclr",
            "request": "launch",
            "program": "${config:nsightGraphics.path}\\host\\windows-desktop-nomad-x64\\ngfx.exe",
            "preLaunchTask": "build-and-tail",
            "postDebugTask": "stop-and-scan-clientlog",
            "env": {
                "VGE_DATA_PATH": "${config:vsmod.debugGame.dataPath}"
            },
            "args": [
                "--activity", "OpenGL Frame Debugger",
                "--wait-hotkey",
                "--exe", "${env:VINTAGE_STORY}\\Vintagestory.exe",
                "--dir", "${env:VINTAGE_STORY}",
                "--args", "--openWorld TestWorld --tracelog --dataPath \"${config:vsmod.debugGame.dataPath}\" --addModPath \"${workspaceFolder}\\VanillaExpanded\\bin\\Debug\\Mods\" --addOrigin \"${workspaceFolder}\\VanillaExpanded\\assets\""
            ],
            "cwd": "${env:VINTAGE_STORY}",
            "console": "internalConsole",
            "internalConsoleOptions": "neverOpen",
            "stopAtEntry": false
        },
        {
            "name": "Launch Client (CPU Profile)",
            "type": "coreclr",
            "request": "launch",
            "program": "C:/Program Files/PowerShell/7/pwsh.exe",
            "preLaunchTask": "Build (dotnet)",
            "env": {
                "VGE_DATA_PATH": "${config:vsmod.debugGame.dataPath}"
            },
            "args": [
                "-NoProfile",
                "-File", "${workspaceFolder}/tools/Start-ClientCpuProfile.ps1",
                "-WorkspaceRoot", "${workspaceFolder}",
                "-GameRoot", "${env:VINTAGE_STORY}",
                "-DataPath", "${config:vsmod.debugGame.dataPath}"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "stopAtEntry": false
        },
        {
            "name": "Launch Server",
            "type": "coreclr",
            "request": "launch",
            "program": "${env:VINTAGE_STORY}/VintagestoryServer.exe",
            "linux": {
                "program": "${env:VINTAGE_STORY}/VintagestoryServer"
            },
            "osx": {
                "program": "${env:VINTAGE_STORY}/VintagestoryServer"
            },
            "preLaunchTask": "Build (dotnet)",
            "env": {
                "VGE_DATA_PATH": "${config:vsmod.debugGame.dataPath}"
            },
            "args": [
                "--tracelog",
                "--dataPath",
                "${config:vsmod.debugGame.dataPath}",
                "--addModPath",
                "${config:vsmod.projectFolder}/bin/Debug/Mods",
                 "--addOrigin",
                 "${config:vsmod.projectFolder}/assets"
            ],
            "console": "internalConsole",
            "stopAtEntry": false
        },
        {
            "name": "CakeBuild",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build (Cake)",
            "program": "${workspaceFolder}/CakeBuild/bin/Debug/net10.0/CakeBuild.dll",
            "args": [],
            "cwd": "${workspaceFolder}/CakeBuild",
            "stopAtEntry": false,
            "console": "internalConsole"
        }
    ]
}