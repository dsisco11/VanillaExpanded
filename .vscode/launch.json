{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Client (RenderDoc)",
            "type": "coreclr",
            "request": "launch",
            "program": "${config:vanillaExpanded.renderdocPath}/renderdoccmd.exe",
            "preLaunchTask": "Build (Cake)",
            "args": [
                "capture",
                "--wait-for-exit",
                "${env:VINTAGE_STORY}/Vintagestory.exe",
                "--tracelog",
                "--addModPath",
                "${workspaceFolder}/VanillaExpanded/bin/Debug/Mods",
                "--addOrigin",
                "${workspaceFolder}/VanillaExpanded/assets"
                // "--playStyle" , "preset-surviveandbuild",
                // "--openWorld" , "modding test world",
            ],
            "cwd": "${env:VINTAGE_STORY}",
            "console": "internalConsole",
            "internalConsoleOptions": "neverOpen",
            "stopAtEntry": false
        },
        {
            "name": "Launch Server",
            "type": "coreclr",
            "request": "launch",
            "program": "${env:VINTAGE_STORY}/VintagestoryServer.exe",
            "linux": {
                "program": "${env:VINTAGE_STORY}/VintagestoryServer"
            },
            "osx": {
                "program": "${env:VINTAGE_STORY}/VintagestoryServer"
            },
            "preLaunchTask": "build",
            "args": [
                "--tracelog",
                "--addModPath",
                "${workspaceFolder}/VanillaExpanded/bin/Debug/Mods",
                 "--addOrigin",
                 "${workspaceFolder}/VanillaExpanded/assets"
            ],
            "console": "internalConsole",
            "stopAtEntry": false
        },
        {
            "name": "CakeBuild",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build (Cake)",
            "program": "${workspaceFolder}/CakeBuild/bin/Debug/net10.0/CakeBuild.dll",
            "args": [],
            "cwd": "${workspaceFolder}/CakeBuild",
            "stopAtEntry": false,
            "console": "internalConsole"
        }
    ]
}